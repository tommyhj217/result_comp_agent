# ─────────────────────────────────────────────────────────────────────────────
# Azure OpenAI (GPT) 설정 — 이 파일을 .env 로 복사해 값을 채우세요.
# 설정 점검:  rca check-env            실제 호출 점검:  rca check-env --probe
# 탐색 순서: --env-file > RCA_ENV_FILE > 설정 파일(config.yaml) 폴더의 .env > 현재 폴더의 .env
# 실제 환경변수가 .env 보다 우선합니다 (--env-override 로 반대로).
# ─────────────────────────────────────────────────────────────────────────────

# [필수 4개]
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<api-key>
AZURE_OPENAI_DEPLOYMENT=<GPT 배포 이름>          # Azure 포털 > 배포(Deployments) 의 '이름' (모델명이 아님)
AZURE_OPENAI_API_VERSION=2024-10-21               # 예: 2024-10-21, 2025-04-01-preview / v1 엔드포인트면 v1

# [선택]
# AZURE_OPENAI_DEPLOYMENT_FAST=<교차검증용 배포>   # 없으면 AZURE_OPENAI_DEPLOYMENT 사용
# AZURE_OPENAI_TIMEOUT=120                        # GPT 호출 1회 제한 시간(초) — 초과 시 재시도 후 '시간 초과' 실패로 표시
# RCA_LLM_BUDGET_SECONDS=1800                     # 실행 전체 GPT 시간 예산(초), 0=무제한
# AZURE_OPENAI_REASONING_EFFORT=medium            # 추론형 GPT(o-시리즈/GPT-5 계열)에서만 의미, 미지원 모델이면 자동 제외
# AZURE_OPENAI_TEMPERATURE=0                      # 지원하지 않는 모델이면 자동 제외
# AZURE_OPENAI_SEED=42
# AZURE_OPENAI_MAX_OUTPUT_TOKENS=8000
# AZURE_OPENAI_USE_ENTRA_ID=true                  # API 키 대신 Entra ID (pip install "result-comp-agent[entra]")

# 사설 git 저장소 인증 (credential helper 를 쓰지 않을 때)
# RCA_GIT_AUTH_HEADER=Authorization: Basic <base64(user:token)>

# 사용자 플러그인 (문서 핸들러 / GPT 도구), 쉼표 구분
# RCA_PLUGINS=my_company.rca_plugins,./plugins/hwp_handler.py
