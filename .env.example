# Azure OpenAI (GPT-6 시리즈) — 설정하지 않으면 규칙 기반(오프라인)으로 동작합니다.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<api-key>
# API 키 대신 Entra ID(Managed Identity / az login) 사용 시: pip install "result-comp-agent[entra]"
# AZURE_OPENAI_USE_ENTRA_ID=true

# api-version 지정 방식(기본) 또는 v1 엔드포인트(https://<resource>.openai.azure.com/openai/v1/) 사용 시 v1
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Azure 포털의 '배포 이름'
AZURE_OPENAI_DEPLOYMENT_MAIN=gpt-6
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-6-mini

# 추론 강도 (빈 값이면 파라미터 미전송)
AZURE_OPENAI_REASONING_EFFORT=medium
# 추론 모델은 temperature 를 지원하지 않을 수 있어 기본 미전송. 필요할 때만 지정
# AZURE_OPENAI_TEMPERATURE=0
AZURE_OPENAI_SEED=42

# 사설 git 저장소 인증 (credential helper 를 쓰지 않을 때)
# RCA_GIT_AUTH_HEADER="Authorization: Basic <base64(user:token)>"
